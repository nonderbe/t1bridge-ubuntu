#!/bin/bash
# T1Bridge desktop provider v1 for GNOME on Ubuntu (PipeWire/WirePlumber, MPRIS,
# desktop notifications). Contract: T1Bridge docs/interfaces.md, "Desktop
# provider v1". The t1-touchbar user service runs it as the graphical user via
# T1BRIDGE_DESKTOP_PROVIDER; T1Bridge's root service never calls it.
#
# Gives the built-in renderer volume, mute and media buttons, a notification
# for renderer fallbacks, and a dark Touch Bar while the laptop panel and all
# external displays are off. Every call has a 500 ms deadline, so the inner
# timeouts of one call add up to at most ~0.4 s; `status` runs once a second
# and uses only wpctl, one D-Bus call and sysfs reads.
set -uo pipefail
export LC_ALL=C

CAP_AUDIO=1 CAP_MEDIA=2 CAP_NOTIFY=4 CAP_DISPLAY=16
SINK=@DEFAULT_AUDIO_SINK@
SYSFS=${T1BRIDGE_GNOME_SYSFS:-/sys}	# overridable for tests

# volume_state: "PERCENT MUTED" for the default sink, from "Volume: 0.36" or
# "Volume: 0.36 [MUTED]". Nothing (and status 1) without a sink.
volume_state() {
	local out
	out=$(timeout 0.15 wpctl get-volume "$SINK" 2>/dev/null) || return 1
	awk '$1 == "Volume:" && $2 ~ /^[0-9.]+$/ {
		v = int($2 * 100 + 0.5); if (v > 100) v = 100
		print v, ($3 == "[MUTED]") ? 1 : 0; found = 1
	} END { exit !found }' <<<"$out"
}

# mpris_players: bus names of the running MPRIS players, one per line.
mpris_players() {
	timeout 0.15 gdbus call --session --dest org.freedesktop.DBus \
		--object-path /org/freedesktop/DBus --method org.freedesktop.DBus.ListNames 2>/dev/null |
		grep -o "org\.mpris\.MediaPlayer2\.[A-Za-z0-9_.-]*" || :
}

# media_player: the player to control, a playing one first (at most two are
# probed, 0.05 s each, to stay inside the deadline).
media_player() {
	local p first="" n=0
	while read -r p; do
		[ -n "$p" ] || continue
		[ -n "$first" ] || first=$p
		n=$((n + 1)); [ "$n" -le 2 ] || break
		if timeout 0.05 gdbus call --session --dest "$p" --object-path /org/mpris/MediaPlayer2 \
			--method org.freedesktop.DBus.Properties.Get org.mpris.MediaPlayer2.Player PlaybackStatus \
			2>/dev/null | grep -q Playing; then
			echo "$p"; return 0
		fi
	done < <(mpris_players)
	[ -n "$first" ] && echo "$first"
}

# is_touchbar CONNECTOR: the connector belongs to the T1 (USB 05ac:8600).
is_touchbar() {
	local d
	d=$(readlink -f "$1")
	while [ -n "$d" ] && [ "$d" != / ]; do
		if [ -r "$d/idVendor" ] && [ -r "$d/idProduct" ]; then
			[ "$(cat "$d/idVendor"):$(cat "$d/idProduct")" = 05ac:8600 ]
			return
		fi
		d=${d%/*}
	done
	return 1
}

# display_state: "1" while a connected display other than the Touch Bar is on,
# "0" while all are off, nothing when none is found.
display_state() {
	local c status dpms seen="" on=""
	for c in "$SYSFS"/class/drm/card*-*; do
		[ -r "$c/status" ] && [ -r "$c/dpms" ] || continue
		is_touchbar "$c" && continue
		read -r status < "$c/status" || continue
		[ "$status" = connected ] || continue
		read -r dpms < "$c/dpms" || continue
		seen=1
		[ "$dpms" = On ] && on=1
	done
	[ -n "$seen" ] || return 0
	if [ -n "$on" ]; then echo 1; else echo 0; fi
}

status() {
	local caps=0 vol="-" muted="-" disp state
	command -v notify-send >/dev/null && caps=$CAP_NOTIFY
	if state=$(volume_state); then
		caps=$((caps | CAP_AUDIO))
		read -r vol muted <<<"$state"
	fi
	[ -n "$(mpris_players)" ] && caps=$((caps | CAP_MEDIA))
	disp=$(display_state)
	if [ -n "$disp" ]; then
		caps=$((caps | CAP_DISPLAY))
		echo "T1BRIDGE-DESKTOP 1 $caps $vol $muted $disp"
	else
		echo "T1BRIDGE-DESKTOP 1 $caps $vol $muted"
	fi
}

media() { # $1 = Previous | PlayPause | Next
	local p
	p=$(media_player)
	[ -n "$p" ] || return 1
	timeout 0.12 gdbus call --session --dest "$p" --object-path /org/mpris/MediaPlayer2 \
		--method "org.mpris.MediaPlayer2.Player.$1" >/dev/null 2>&1
}

[ "${1:-}" = v1 ] || exit 2
op=${2:-}
case "$op" in
status)
	[ $# -eq 2 ] || exit 2
	status
	;;
set-volume)
	[ $# -eq 3 ] || exit 2
	case "$3" in ''|*[!0-9]*) exit 2 ;; esac
	[ "$3" -le 100 ] || exit 2
	timeout 0.4 wpctl set-volume "$SINK" "$3%"
	;;
toggle-mute)
	[ $# -eq 2 ] || exit 2
	timeout 0.4 wpctl set-mute "$SINK" toggle
	;;
media-previous) media Previous ;;
media-play-pause) media PlayPause ;;
media-next) media Next ;;
show-display-brightness|show-keyboard-backlight)
	exit 0	# level feedback is not advertised; nothing to show
	;;
notify-renderer-fallback)
	case "${3:-}" in
	selection-unavailable) msg="The selected Touch Bar renderer is unavailable; using the built-in one." ;;
	selection-exited) msg="The selected Touch Bar renderer exited; using the built-in one." ;;
	*) exit 2 ;;
	esac
	timeout 0.4 notify-send -a "Touch Bar" "Touch Bar" "$msg" >/dev/null 2>&1 &
	;;
*)
	exit 2
	;;
esac
